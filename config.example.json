{
  "database": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "",
    "password": "",
    "database": "kernelinfo",
    "path": "",
    "timeout": 10,
    "engine": "mariadb",
    "unix_socket": "auto",
    "ssh_tunnel": {
      "enabled": false,
      "host": "remote-server.example.com",
      "port": 22,
      "user": "ubuntu",
      "password": "",
      "key_file": "~/.ssh/id_ed25519",
      "remote_host": "127.0.0.1",
      "remote_port": 3306,
      "local_port": 0,
      "strict_host_key_checking": "accept-new",
      "connect_timeout": 10
    }
  },
  "cache": {
    "engine": "ram",
    "dir": ""
  },
  "webapp": {
    "host": "0.0.0.0",
    "port": 8000,
    "reload": true
  },
  "parser": {
    "table_engine": "cached",
    "memory_mode": "normal",
    "mem_max": 48,
    "hugepages": "auto",
    "preload_flush_mb": 512,
    "cache_max_table_mb": 6144,
    "distributed": {
      "enabled": false,
      "role": "master",
      "worker_id": "",
      "delegate_stable": true,
      "delegate_branches": [],
      "lease_ttl_seconds": 180,
      "heartbeat_seconds": 30
    }
  },
  "mailing_list": {
    "storage_dir": "/srv/lore",
    "port": 8192,
    "batch_size": 50,
    "request_timeout": 180,
    "daemon_max_rss_mb": 1024,
    "daemon_max_concurrent": 4,
    "auto_start_daemon": true,
    "ssh_tunnel": {
      "enabled": false,
      "host": "remote-server.example.com",
      "port": 22,
      "user": "ubuntu",
      "password": "",
      "key_file": "~/.ssh/id_ed25519",
      "remote_host": "127.0.0.1",
      "remote_port": 8192,
      "local_port": 0,
      "strict_host_key_checking": "accept-new",
      "connect_timeout": 10
    }
  },
  "workspace": {
    "repos_dir": "repos",
    "auto_detect_repos": true
  },
  "repositories": [
    {
      "name": "linux",
      "path": "repos/linux",
      "project": "linux",
      "default_branch": "master",
      "git_url": "https://github.com/torvalds/linux",
      "root_commit": "1da177e4c3f41524e886b7f1b8a0c1fc7321cac2",
      "start_ref": "1da177e4c3f41524e886b7f1b8a0c1fc7321cac2",
      "enabled": true,
      "branch_filter": {
        "include": [
          "*"
        ],
        "exclude": [
          "*rc*"
        ]
      },
      "branches": [
        "master",
        "stable/linux-6.6.y"
      ],
      "tag_views": [
        {
          "name": "— any branch —",
          "regex_rules": [
            "^(v2\\.6\\.\\d+)((?:-(?:rc|pre|alpha|beta)\\d*|\\.\\d+(?:-(?:rc|pre|alpha|beta)\\d*)?).*)$",
            "^(v(?!2\\.6\\.)\\d+\\.\\d+)((?:-(?:rc|pre|alpha|beta)\\d*|\\.\\d+(?:-(?:rc|pre|alpha|beta)\\d*)?).*)$"
          ]
        }
      ]
    },
    {
      "name": "man-pages",
      "path": "repos/man-pages",
      "project": "man-pages",
      "default_branch": "master",
      "git_url": "https://git.kernel.org/pub/scm/docs/man-pages/man-pages.git",
      "root_commit": "fea681dafb1363a154b7fc6d59baa83d2a9ebc5c",
      "start_ref": "fea681dafb1363a154b7fc6d59baa83d2a9ebc5c",
      "enabled": true,
      "branch_filter": {
        "include": [
          "master"
        ],
        "exclude": []
      },
      "branches": [
        "master"
      ],
      "tag_views": [
        {
          "name": "— man-pages —",
          "regex_rules": [
            "^(man-pages-\\d+)(\\..*)$"
          ]
        }
      ]
    }
  ]
}