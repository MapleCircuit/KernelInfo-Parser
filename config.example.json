{
  "database": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "",
    "password": "",
    "database": "kernelinfo",
    "path": "",
    "timeout": 10,
    "connect_timeout": 20,
    "read_timeout": 600,
    "write_timeout": 300,
    "long_read_timeout": 7200,
    "engine": "mariadb",
    "unix_socket": "auto",
    "ssh_tunnel": {
      "enabled": false,
      "host": "remote-server.example.com",
      "port": 22,
      "user": "ubuntu",
      "password": "",
      "key_file": "~/.ssh/id_ed25519",
      "remote_host": "127.0.0.1",
      "remote_port": 3306,
      "local_port": 0,
      "strict_host_key_checking": "accept-new",
      "connect_timeout": 10
    }
  },
  "cache": {
    "engine": "ram",
    "dir": ""
  },
  "webapp": {
    "host": "0.0.0.0",
    "port": 8000,
    "reload": true
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8001,
    "reload": false,
    "default_version": "v3.0",
    "allow_writes": false,
    "nodemap_canvas_dir": "",
    "keys": [],
    "rate_limit": {
      "max_requests": 120,
      "window_seconds": 60
    },
    "auth_lockout": {
      "max_failures": 5,
      "failure_window_seconds": 60,
      "base_lockout_seconds": 30,
      "max_lockout_seconds": 3600
    },
    "trusted_proxies": [
      "127.0.0.1",
      "::1"
    ],
    "client_ip_header": "X-Forwarded-For",
    "oauth": {
      "enabled": false,
      "issuer": "https://kernelinfo.org",
      "signing_secret": "",
      "data_dir": "",
      "access_token_ttl": 3600,
      "refresh_token_ttl": 2592000,
      "auth_code_ttl": 120,
      "allow_dcr": true,
      "allow_cimd": true,
      "allowed_redirect_uris": [
        "https://claude.ai/api/mcp/auth_callback",
        "https://claude.com/api/mcp/auth_callback",
        "https://chatgpt.com/connector_platform_oauth_redirect",
        "https://chatgpt.com/connector/oauth/*",
        "https://www.cursor.com/agents/mcp/oauth/callback",
        "cursor://anysphere.cursor-mcp/oauth/callback",
        "https://*.google.com/*",
        "https://gemini.google.com/*",
        "https://vscode.dev/redirect",
        "vscode://*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://[::1]/*"
      ],
      "clients": []
    }
  },
  "parser": {
    "table_engine": "cached",
    "memory_mode": "normal",
    "mem_max": 48,
    "hugepages": "auto",
    "preload_flush_mb": 512,
    "cache_max_table_mb": 6144,
    "worker_batch_timeout_s": 300,
    "worker_retry_file_timeout_s": 90,
    "distributed": {
      "enabled": false,
      "role": "master",
      "worker_id": "",
      "delegate_stable": true,
      "delegate_branches": [],
      "lease_ttl_seconds": 180,
      "heartbeat_seconds": 30,
      "poll_interval_seconds": 60,
      "git_auto_update": true,
      "git_update_interval_seconds": 300,
      "lock_dir": ""
    }
  },
  "mailing_list": {
    "storage_dir": "/srv/lore",
    "port": 8192,
    "batch_size": 50,
    "request_timeout": 180,
    "daemon_max_rss_mb": 1024,
    "daemon_max_concurrent": 4,
    "auto_start_daemon": true,
    "ssh_tunnel": {
      "enabled": false,
      "host": "remote-server.example.com",
      "port": 22,
      "user": "ubuntu",
      "password": "",
      "key_file": "~/.ssh/id_ed25519",
      "remote_host": "127.0.0.1",
      "remote_port": 8192,
      "local_port": 0,
      "strict_host_key_checking": "accept-new",
      "connect_timeout": 10
    }
  },
  "workspace": {
    "repos_dir": "repos",
    "auto_detect_repos": true
  },
  "logging": {
    "parser": {
      "enabled": false,
      "dir": "",
      "file": "parser.log",
      "error_dir": "",
      "error_file": "",
      "level": "INFO"
    },
    "webapp": {
      "enabled": false,
      "dir": "",
      "file": "webapp.log",
      "request_mode": "all",
      "error_dir": "",
      "error_file": "",
      "level": "INFO"
    },
    "api": {
      "enabled": false,
      "dir": "",
      "file": "api.log",
      "request_mode": "all",
      "error_dir": "",
      "error_file": "",
      "level": "INFO"
    }
  },
  "repositories": [
    {
      "name": "linux",
      "path": "repos/linux",
      "project": "linux",
      "default_branch": "master",
      "git_url": "https://github.com/torvalds/linux",
      "root_commit": "1da177e4c3f41524e886b7f1b8a0c1fc7321cac2",
      "start_ref": "1da177e4c3f41524e886b7f1b8a0c1fc7321cac2",
      "enabled": true,
      "branch_filter": {
        "include": [
          "*"
        ],
        "exclude": [
          "*rc*"
        ]
      },
      "branches": [
        "master",
        "stable/linux-6.6.y"
      ],
      "tag_views": [
        {
          "name": "— any branch —",
          "regex_rules": [
            "^(v2\\.6\\.\\d+)([.-].*)$",
            "^(v?(?!2\\.6\\.)\\d+\\.\\d+)((?:[.-]|[a-zA-Z]).*)$",
            "^([a-zA-Z][a-zA-Z0-9_-]*?-v?\\d+\\.\\d+|[a-zA-Z][a-zA-Z0-9_-]*?(?=-v\\d+)|pre\\d+\\.\\d+|next)([.-].*)$"
          ]
        }
      ],
      "preparse": {
        "insights": {
          "mode": "all_main"
        },
        "api": {
          "mode": "all_main"
        }
      }
    },
    {
      "name": "man-pages",
      "path": "repos/man-pages",
      "project": "man-pages",
      "default_branch": "master",
      "git_url": "https://git.kernel.org/pub/scm/docs/man-pages/man-pages.git",
      "root_commit": "fea681dafb1363a154b7fc6d59baa83d2a9ebc5c",
      "start_ref": "fea681dafb1363a154b7fc6d59baa83d2a9ebc5c",
      "enabled": true,
      "branch_filter": {
        "include": [
          "master"
        ],
        "exclude": []
      },
      "branches": [
        "master"
      ],
      "tag_views": [
        {
          "name": "— man-pages —",
          "regex_rules": [
            "^(man-pages-\\d+)(\\..*)$"
          ]
        }
      ]
    }
  ]
}